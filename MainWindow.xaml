<Window x:Class="BandoriLove.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BandoriLove" Width="1000" Height="690" MinWidth="720" MinHeight="520"
        Background="White" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="254"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="#F8F8F9" BorderBrush="#E7E7EA" BorderThickness="0,0,1,0">
      <DockPanel Margin="18,24,18,18">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="BandoriLove" FontSize="22" FontWeight="SemiBold" Margin="7,0,0,28"/>
          <DockPanel Margin="7,0,0,10">
            <Button DockPanel.Dock="Right" Content="+ 添加" Padding="9,5" Click="AddCard"/>
            <TextBlock Text="角色卡" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </DockPanel>
        </StackPanel>
        <Button x:Name="EditButton" DockPanel.Dock="Bottom" Content="编辑角色卡" Click="EditCard" IsEnabled="False"/>
        <Grid Margin="0,0,0,14">
          <TextBlock x:Name="EmptyCards" Text="添加一张角色卡开始" Foreground="#62626B" Margin="8,10,0,0"/>
          <ListBox x:Name="Cards" BorderThickness="0" Background="Transparent"
                   DisplayMemberPath="Name" SelectionChanged="CardChanged" AutomationProperties.Name="角色卡列表">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </Grid>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="38,30,38,23">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="0,3,0,23">
        <TextBlock Text="语音合成" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock x:Name="CharacterLabel" Text="请先添加角色卡" Foreground="#62626B" Margin="0,7,0,0"/>
      </StackPanel>
      <DockPanel Grid.Row="1" Margin="0,0,0,9" LastChildFill="False">
        <ComboBox x:Name="InputLanguage" Width="142" SelectedValuePath="Tag" SelectedIndex="0" DockPanel.Dock="Right"
                  AutomationProperties.Name="输入语言">
          <ComboBoxItem Content="日语" Tag="ja"/>
          <ComboBoxItem Content="中文" Tag="zh"/>
          <ComboBoxItem Content="英语" Tag="en"/>
          <ComboBoxItem Content="自动识别" Tag="auto"/>
        </ComboBox>
        <Label Content="朗读文本" Target="{Binding ElementName=ScriptText}" Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
      </DockPanel>
      <TextBox x:Name="ScriptText" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" FontSize="17"
               VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="3000"
               Padding="14,12" TextChanged="ScriptChanged" AutomationProperties.Name="朗读文本"/>
      <DockPanel Grid.Row="3" Margin="0,13,0,18" LastChildFill="False">
        <Button x:Name="GenerateButton" DockPanel.Dock="Right" Content="生成语音" Background="#212124" Foreground="White"
                BorderBrush="#212124" Click="Generate" IsEnabled="False"/>
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" Click="CancelGeneration" Margin="0,0,8,0" Visibility="Collapsed"/>
        <TextBlock x:Name="TextCount" DockPanel.Dock="Left" Text="0 / 3000" Foreground="#62626B" VerticalAlignment="Center"/>
      </DockPanel>
      <Border Grid.Row="4" Background="#F7F7F8" CornerRadius="11" Padding="13">
        <DockPanel LastChildFill="True">
          <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="保存 WAV" Click="SaveAudio" IsEnabled="False"/>
          <Button x:Name="StopButton" DockPanel.Dock="Right" Content="停止" Margin="0,0,8,0" Click="StopAudio" IsEnabled="False"/>
          <Button x:Name="PlayButton" DockPanel.Dock="Right" Content="播放" Margin="0,0,8,0" Click="PlayAudio" IsEnabled="False"/>
          <TextBlock x:Name="AudioLabel" Text="生成结果" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" Margin="2,0,7,0"/>
        </DockPanel>
      </Border>
      <TextBlock x:Name="Status" Grid.Row="5" MinHeight="21" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#62626B"/>
    </Grid>
  </Grid>
</Window>
