<Window x:Class="BandoriLove.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="角色卡" Width="565" SizeToContent="Height" MaxHeight="750" MinHeight="365"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,22">
      <TextBlock x:Name="Heading" Text="添加角色卡" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Label Content="角色名称" Target="{Binding ElementName=CardName}" Padding="0,3"/>
      <TextBox x:Name="CardName" MaxLength="100" Margin="0,0,0,8"/>
      <Label Content="GPT-SoVITS API 地址" Target="{Binding ElementName=Endpoint}" Padding="0,3"/>
      <TextBox x:Name="Endpoint" Margin="0,0,0,8"/>
      <Label Content="推理端参考音频路径" Target="{Binding ElementName=ReferenceAudio}" Padding="0,3"/>
      <TextBox x:Name="ReferenceAudio" Margin="0,0,0,8"/>
      <Label Content="参考台词" Target="{Binding ElementName=Prompt}" Padding="0,3"/>
      <TextBox x:Name="Prompt" Margin="0,0,0,8" AcceptsReturn="True" Height="58"
               VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      <Label Content="参考语言" Target="{Binding ElementName=PromptLanguage}" Padding="0,3"/>
      <ComboBox x:Name="PromptLanguage" SelectedValuePath="Tag" SelectedIndex="0" Margin="0,0,0,11">
        <ComboBoxItem Content="日语" Tag="ja"/>
        <ComboBoxItem Content="中文" Tag="zh"/>
        <ComboBoxItem Content="英语" Tag="en"/>
      </ComboBox>
      <Expander x:Name="Weights" Header="权重路径（推理端已加载模型时可留空）">
        <StackPanel Margin="0,5,0,0">
          <Label Content="GPT 权重路径（.ckpt）" Target="{Binding ElementName=Gpt}" Padding="0,3"/>
          <TextBox x:Name="Gpt" Margin="0,0,0,8"/>
          <Label Content="SoVITS 权重路径（.pth）" Target="{Binding ElementName=Sovits}" Padding="0,3"/>
          <TextBox x:Name="Sovits"/>
        </StackPanel>
      </Expander>
      <TextBlock x:Name="ErrorText" Foreground="#A91E26" TextWrapping="Wrap" Margin="0,9,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
        <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
        <Button Content="保存角色卡" IsDefault="True" Click="SaveCard" Background="#212124" Foreground="White" BorderBrush="#212124"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
